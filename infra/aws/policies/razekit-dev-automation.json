{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthTokenIsAccountWideByDesign",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushAndInspectTheWorkerImageOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages"
      ],
      "Resource": "arn:aws:ecr:us-east-2:${AWS_ACCOUNT_ID}:repository/razekit-dev-worker"
    },
    {
      "Sid": "TaskDefinitionApisCannotBeResourceScoped",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyTheRazekitDevCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DescribeServices",
        "ecs:ListServices",
        "ecs:DescribeClusters",
        "ecs:ListTasks",
        "ecs:DescribeTasks",
        "ecs:RunTask",
        "ecs:StopTask"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-2:${AWS_ACCOUNT_ID}:cluster/razekit-dev",
        "arn:aws:ecs:us-east-2:${AWS_ACCOUNT_ID}:service/razekit-dev/*",
        "arn:aws:ecs:us-east-2:${AWS_ACCOUNT_ID}:task/razekit-dev/*",
        "arn:aws:ecs:us-east-2:${AWS_ACCOUNT_ID}:task-definition/razekit-dev-worker:*"
      ]
    },
    {
      "Sid": "PassOnlyTheTwoTaskRolesAndOnlyToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/razekit-dev-task-execution-role",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/razekit-dev-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OwnLogGroupsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:PutRetentionPolicy",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:${AWS_ACCOUNT_ID}:log-group:/razekit-dev/*"
    },
    {
      "Sid": "ObserveTheQueueButNeverConsumeIt",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueues"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:${AWS_ACCOUNT_ID}:razekit-dev-jobs",
        "arn:aws:sqs:us-east-2:${AWS_ACCOUNT_ID}:razekit-dev-jobs-dlq"
      ]
    },
    {
      "Sid": "ReadArtifactsForVerificationNeverWriteThem",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::razekit-dev-artifacts-${AWS_ACCOUNT_ID}-us-east-2",
        "arn:aws:s3:::razekit-dev-artifacts-${AWS_ACCOUNT_ID}-us-east-2/*"
      ]
    },
    {
      "Sid": "KnowThatSecretsExistWithoutBeingAbleToReadThem",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:${AWS_ACCOUNT_ID}:secret:razekit-dev/*"
    },
    {
      "Sid": "NetworkingIsReadOnlyAndDescribeCannotBeScoped",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeAvailabilityZones"
      ],
      "Resource": "*"
    }
  ]
}

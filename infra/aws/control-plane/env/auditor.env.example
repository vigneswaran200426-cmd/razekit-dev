# System B — Runtime Operations and Auditor. /etc/razekit/auditor.env, 0600, owner razekit-auditor.
# No GitHub token, no AWS keys: System B files tasks for System A instead of changing code.
NODE_ENV=production
RAZEKIT_STORE=postgres
# SECRET
RAZEKIT_DATABASE_URL=
RAZEKIT_DATABASE_SCHEMA=razekit_dev
RAZEKIT_DB_POOL_MAX=3
RAZEKIT_OPS_WORKSPACE_ROOT=/var/lib/razekit/auditor/workspaces
RAZEKIT_OPS_LOG_DIR=/var/lib/razekit/auditor/logs
RAZEKIT_DEV_BASE_URL=https://razekit-dev.onrender.com
RAZEKIT_AUDIT_INTERVAL_MINUTES=5
# Reversible repairs System B may perform on its own.
RAZEKIT_AUDITOR_REPAIRS=recover-expired-jobs,recover-expired-workers,requeue-stuck-inference
# Notifications are queued for the gateway to send: System B cannot reach the
# instance role that SES needs (it is firewalled from instance metadata).
# ADMIN_EMAIL and the sender live in gateway.env.
RAZEKIT_NOTIFY_VIA=gateway
RAZEKIT_DAILY_REPORT_HOUR_UTC=3

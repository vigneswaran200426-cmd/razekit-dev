# System A — RazeKit DEV Builder. /etc/razekit/builder.env, mode 0600, owner razekit-builder.
# Only System A's secrets belong here. The process refuses to start if it can
# see System B's or the server's secrets.
NODE_ENV=production
RAZEKIT_STORE=postgres
# SECRET: the DEV Neon connection string (pooled endpoint).
RAZEKIT_DATABASE_URL=
RAZEKIT_DATABASE_SCHEMA=razekit_dev
RAZEKIT_DB_POOL_MAX=3
RAZEKIT_OPS_WORKSPACE_ROOT=/var/lib/razekit/builder/workspaces
RAZEKIT_OPS_LOG_DIR=/var/lib/razekit/builder/logs
RAZEKIT_BUILDER_REPO_URL=https://github.com/vigneswaran200426-cmd/razekit-dev.git
RAZEKIT_BUILDER_REPO=vigneswaran200426-cmd/razekit-dev
RAZEKIT_BUILDER_BASE_BRANCH=main
# SECRET: fine-grained GitHub token for THIS repository only, with
# "Contents: read/write" and "Pull requests: read/write". Without it System A
# commits in its workspace but cannot push or open a draft PR.
RAZEKIT_BUILDER_GITHUB_TOKEN=
RAZEKIT_BUILDER_TEST_TIMEOUT_MS=1200000
# "docker" runs tests in a no-network container; it needs rootless Docker for
# this user (the docker group would be root on the host), so it is off here.
RAZEKIT_BUILDER_SANDBOX=process
RAZEKIT_BUILDER_SANDBOX_IMAGE=node:22-bookworm-slim

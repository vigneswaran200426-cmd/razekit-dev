# Inference gateway. /etc/razekit/gateway.env, 0600, owner razekit-gateway.
# The only process allowed to reach instance metadata (for its instance role).
NODE_ENV=production
RAZEKIT_STORE=postgres
# SECRET
RAZEKIT_DATABASE_URL=
RAZEKIT_DATABASE_SCHEMA=razekit_dev
RAZEKIT_DB_POOL_MAX=2
# Private address of the GPU instance; port 11434 is open to the control plane only.
RAZEKIT_OLLAMA_URL=http://GPU_PRIVATE_IP:11434
RAZEKIT_GPU_INSTANCE_ID=
RAZEKIT_AWS_REGION=us-east-2
RAZEKIT_AWS_ACCOUNT_ID=074189217970
RAZEKIT_AWS_BUDGET_NAME=razekit-dev-monthly
# Hard limits: the gateway refuses to start the GPU unless both are set, and
# stops it when the measured month-to-date estimate reaches the budget.
# Set the rate from the EC2 pricing page for your instance type and region.
RAZEKIT_GPU_HOURLY_USD=
RAZEKIT_GPU_MONTHLY_BUDGET_USD=
RAZEKIT_GPU_IDLE_STOP_MINUTES=20
RAZEKIT_GPU_AUTO_START=false
RAZEKIT_TOKENS_PER_DAY_BUILDER=2000000
RAZEKIT_TOKENS_PER_DAY_AUDITOR=500000
RAZEKIT_TOKENS_PER_DAY_NIOMI=2000000
RAZEKIT_TOKENS_PER_DAY_KONAMI=2000000

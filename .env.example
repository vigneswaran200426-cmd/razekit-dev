# RazeKit DEV — environment template.
#
# Copy to .env and fill in. NEVER commit the filled-in copy: .gitignore already
# excludes .env, and every value below that is a credential is marked as one.
#
# Nothing here has a working default that reaches a real service. An engine
# started with this file as-is runs the deterministic model pair: real files,
# real tests, a real build, a real artifact — no network, no bill.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Where task state and per-task workspaces live. On a real worker these belong
# on a volume that survives a restart, or a recovered task resumes into an empty
# workspace.
RAZEKIT_DATA_DIR=data
RAZEKIT_WORKSPACE_ROOT=data/workspaces

# How often the coordinator advances running builds, recovers expired leases and
# starts newly authorised tasks. Overlapping ticks are skipped, so a value below
# the length of a build step is wasteful rather than harmful.
RAZEKIT_TICK_MS=15000

# ── Database (REQUIRED in production) ───────────────────────────────────────
# json     one local file. Development and CI only: every container would keep its
#          own private copy of state, so production REFUSES to start on it.
# postgres the source of truth. The server creates the schema and tables it needs
#          on first boot (idempotent), so there is no separate migration step.
RAZEKIT_STORE=json
# SECRET. A Postgres connection string for the dedicated RazeKit DEV database
# (Neon project "razekit-dev", database "razekit_dev"). Never a marketplace one.
RAZEKIT_DATABASE_URL=
RAZEKIT_DATABASE_SCHEMA=razekit_dev
RAZEKIT_DB_POOL_MAX=10
RAZEKIT_DB_CONNECT_TIMEOUT_MS=15000

# Per-task object storage on the local disk (artifacts). Put it on a persistent
# volume wherever builds must survive a restart.
RAZEKIT_OBJECT_ROOT=data/objects

# ── Identity boundary ───────────────────────────────────────────────────────
# Identity. RazeKit DEV has its own accounts; it trusts nothing signed by the
# RazeKit marketplace.
#   session  production: a signed-in DEV account behind an HttpOnly cookie
#   local    development only: identity from x-razekit-tenant-id headers
# Defaults to session when NODE_ENV=production, and production refuses local.
RAZEKIT_AUTH_MODE=session

# SECRET, one-time. Lets the first visitor who knows it create the owner
# account on an empty deployment, and does nothing once an owner exists.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RAZEKIT_BOOTSTRAP_TOKEN=

# "open" lets anyone create a member account (after the owner exists).
# Anything else keeps sign-up closed; the owner or an admin adds accounts.
RAZEKIT_SIGNUP=closed

# Session lifetime in hours (default 168 = 7 days).
RAZEKIT_SESSION_TTL_HOURS=168

# Secure cookies default to on in production. Set false only for local http.
# RAZEKIT_COOKIE_SECURE=true

# Other origins allowed to make cookie-authenticated writes, comma-separated.
# The DEV web origin itself is always allowed.
# RAZEKIT_ALLOWED_ORIGINS=https://dev.example.com

# SECRET. The operator token for machines: worker agents and scripted
# operations. In session mode it, or an owner/admin session, is the only way
# into /internal/* (worker registration, leases, tenant suspension, credential
# revocation, manual loop stepping).
RAZEKIT_ADMIN_TOKEN=

# ── Models ──────────────────────────────────────────────────────────────────
# test = deterministic pair (CI, local development)
# real = use Groq with GROQ_API_KEY, or legacy Anthropic + OpenAI adapters
# auto = use a configured real provider; otherwise stay unconfigured unless
#        RAZEKIT_ENABLE_TEST_MODEL_ADAPTERS=true.
RAZEKIT_MODEL_MODE=auto

# Zero-budget starting option: Groq has free developer-tier API access, subject
# to model availability and current rate limits. This adapter never silently
# falls back to a paid provider. See https://console.groq.com/docs/rate-limits
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
# Optional separate model slots:
# GROQ_CODER_MODEL=openai/gpt-oss-120b
# GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192
GROQ_TIMEOUT_MS=180000
# These zero defaults assume the free developer tier only. If paid billing is
# enabled, set accurate rates and a hard budget before sending model requests.
GROQ_INPUT_COST_PER_MTOK=0
GROQ_OUTPUT_COST_PER_MTOK=0

# Legacy FABLE — implementation and coding. Anthropic Messages API.
# Used only if GROQ_API_KEY is not set.
FABLE_API_KEY=
FABLE_MODEL=claude-fable-5-1
# FABLE_API_URL=https://api.anthropic.com/v1/messages
# low | medium | high | xhigh | max
FABLE_EFFORT=high
FABLE_MAX_TOKENS=16000
FABLE_TIMEOUT_MS=600000
FABLE_INPUT_COST_PER_MTOK=10
FABLE_OUTPUT_COST_PER_MTOK=50

# Legacy ASTRA — architecture, planning, review. OpenAI Responses API.
# Used only if GROQ_API_KEY is not set.
ASTRA_API_KEY=
ASTRA_MODEL=gpt-6-astra
# ASTRA_API_URL=https://api.openai.com/v1/responses
# low | medium | high
ASTRA_EFFORT=high
ASTRA_MAX_OUTPUT_TOKENS=16000
ASTRA_TIMEOUT_MS=600000
ASTRA_INPUT_COST_PER_MTOK=10
ASTRA_OUTPUT_COST_PER_MTOK=50
# ASTRA_ORGANIZATION=

# ── Loop limits ─────────────────────────────────────────────────────────────
# Ceilings that make a runaway task impossible. Raising them raises what a
# single task can spend before it stops and asks.
RAZEKIT_MAX_REVIEW_CYCLES=5
RAZEKIT_MODEL_CONTEXT_CHARS=30000
# Charged per execution run, if worker time is billable in your deployment.
# At 0 execution is free but still budget-checked.
RAZEKIT_EXECUTION_RUN_COST=0

# ── Worker agent (runs ON a worker machine, not on the control plane) ───────
# The worker dials out; the control plane never stores an address, so there is
# no IP to configure here and none is recorded.
RAZEKIT_ENGINE_URL=http://127.0.0.1:3000
RAZEKIT_WORKER_POOL=cpu-default
RAZEKIT_WORKER_RESOURCE_CLASS=cpu
RAZEKIT_WORKER_RUNTIME=container
# How many isolated task runtimes this pool may run at once. This is what makes
# one machine serve many tasks instead of one machine per user.
RAZEKIT_WORKER_POOL_CAPACITY=4
RAZEKIT_WORKER_HEARTBEAT_MS=30000
# Defaults to the hostname, so a rebooted worker rejoins as itself.
# RAZEKIT_WORKER_ID=
# Declare only what is actually installed. Claiming unity on a machine without
# it means accepting game builds that cannot run.
RAZEKIT_WORKER_CAPABILITIES=node,npm,git
RAZEKIT_PRODUCTION_WORKER_HEARTBEAT_TIMEOUT_MS=120000

# ── Job queue ───────────────────────────────────────────────────────────────
RAZEKIT_JOB_MAX_ATTEMPTS=3
RAZEKIT_JOB_LEASE_MS=30000
RAZEKIT_JOB_BACKOFF_MS=1000
RAZEKIT_WORKER_LEASE_MS=60000
# Largest single blackboard entry kept for an agent, in characters.
RAZEKIT_BLACKBOARD_ENTRY_CHARS=12000

# ── Test switches (never in production) ─────────────────────────────────────
# RAZEKIT_ENABLE_TEST_MODEL_ADAPTERS=true   registers the deterministic models
# RAZEKIT_ENABLE_TEST_TOOL_ADAPTERS=true    registers echo tool adapters

# ── Graph workers ────────────────────────────────────────────────────────────
# The process that claims and runs JEV nodes: `node src/jev-worker.js`.
# Run as many as you like; the claim is atomic, so two workers produce one
# winner and one "nothing to do".
# RAZEKIT_JEV_WORKER_ID=
RAZEKIT_JEV_WORKER_POLL_MS=1000
# How long a claimed node is held before it is considered stalled. The worker
# renews at a third of this while it works, so this is the window in which a
# worker that DIES is detected, not a limit on how long a node may take.
RAZEKIT_JEV_WORKER_LEASE_MS=120000
# Restrict a worker to one resource class (cpu, gpu, ...). Empty means any.
# RAZEKIT_JEV_WORKER_RESOURCE_CLASS=

# Whether the autonomous loop also RUNS nodes, or only decides what the graph
# should become. Leave true unless a worker is actually running: with no
# claimant, every graph would simply wait.
RAZEKIT_JEV_INLINE_EXECUTION=true

# ── Model nodes ──────────────────────────────────────────────────────────────
# Base cost of one model call, in whole currency units, before the per-kind
# weighting in jev-model-domain.js. At the default of zero nothing is reserved,
# so reserve-before-call holds no money — the measured cost is still recorded
# afterwards and the hard budget still binds, but the reservation only precedes
# the spend once this is set.
RAZEKIT_MODEL_NODE_COST=0
# How many repair cycles a task may go through before it stops for a person.
RAZEKIT_MAX_REPAIR_CYCLES=3
# Ceiling on the context compiled for one model node, in characters.
RAZEKIT_MODEL_CONTEXT_MAX_CHARS=24000

# Whether this process also ticks tasks forward. Leave true unless something
# else does: an engine that accepts tasks and never advances them is a silent
# hang.
RAZEKIT_COORDINATOR_ENABLED=true

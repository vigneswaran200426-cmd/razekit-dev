# RazeKit DEV — environment template.
#
# Copy to .env and fill in. NEVER commit the filled-in copy: .gitignore already
# excludes .env, and every value below that is a credential is marked as one.
#
# Nothing here has a working default that reaches a real service. An engine
# started with this file as-is runs the deterministic model pair: real files,
# real tests, a real build, a real artifact — no network, no bill.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Where task state and per-task workspaces live. On a real worker these belong
# on a volume that survives a restart, or a recovered task resumes into an empty
# workspace.
RAZEKIT_DATA_DIR=data
RAZEKIT_WORKSPACE_ROOT=data/workspaces

# How often the coordinator advances running builds, recovers expired leases and
# starts newly authorised tasks. Overlapping ticks are skipped, so a value below
# the length of a build step is wasteful rather than harmful.
RAZEKIT_TICK_MS=15000

# ── Identity boundary ───────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. With this off, any caller can assert any tenant by
# setting a header. With it on, only a principal signed with the shared secret
# is accepted.
RAZEKIT_REQUIRE_SIGNED_PRINCIPAL=true

# SECRET. Must match DEV_PRINCIPAL_SECRET in the RazeKit API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RAZEKIT_PRINCIPAL_SECRET=

# SECRET. Guards the administrative surface: worker registration, tenant
# suspension, credential revocation, manual loop stepping.
RAZEKIT_ADMIN_TOKEN=

# ── Models ──────────────────────────────────────────────────────────────────
# test = deterministic pair (CI, local development)
# real = live providers; fails to start if either key is missing
# auto = real when both keys are present, otherwise test
RAZEKIT_MODEL_MODE=auto

# FABLE — implementation and coding. Anthropic Messages API.
# SECRET.
FABLE_API_KEY=
FABLE_MODEL=claude-fable-5-1
# FABLE_API_URL=https://api.anthropic.com/v1/messages
# low | medium | high | xhigh | max
FABLE_EFFORT=high
FABLE_MAX_TOKENS=16000
FABLE_TIMEOUT_MS=600000
# Per-million-token rates, used for budget accounting. Update when the provider
# changes price — an adapter that under-reports cost silently raises every
# task's hard budget.
FABLE_INPUT_COST_PER_MTOK=10
FABLE_OUTPUT_COST_PER_MTOK=50

# ASTRA — architecture, planning, review. OpenAI Responses API.
# SECRET.
ASTRA_API_KEY=
ASTRA_MODEL=gpt-6-astra
# ASTRA_API_URL=https://api.openai.com/v1/responses
# low | medium | high
ASTRA_EFFORT=high
ASTRA_MAX_OUTPUT_TOKENS=16000
ASTRA_TIMEOUT_MS=600000
ASTRA_INPUT_COST_PER_MTOK=10
ASTRA_OUTPUT_COST_PER_MTOK=50
# ASTRA_ORGANIZATION=

# ── Loop limits ─────────────────────────────────────────────────────────────
# Ceilings that make a runaway task impossible. Raising them raises what a
# single task can spend before it stops and asks.
RAZEKIT_MAX_REVIEW_CYCLES=5
RAZEKIT_MODEL_CONTEXT_CHARS=30000
# Charged per execution run, if worker time is billable in your deployment.
# At 0 execution is free but still budget-checked.
RAZEKIT_EXECUTION_RUN_COST=0

# ── Worker agent (runs ON a worker machine, not on the control plane) ───────
# The worker dials out; the control plane never stores an address, so there is
# no IP to configure here and none is recorded.
RAZEKIT_ENGINE_URL=http://127.0.0.1:3000
RAZEKIT_WORKER_POOL=cpu-default
RAZEKIT_WORKER_RESOURCE_CLASS=cpu
RAZEKIT_WORKER_RUNTIME=container
# How many isolated task runtimes this pool may run at once. This is what makes
# one machine serve many tasks instead of one machine per user.
RAZEKIT_WORKER_POOL_CAPACITY=4
RAZEKIT_WORKER_HEARTBEAT_MS=30000
# Defaults to the hostname, so a rebooted worker rejoins as itself.
# RAZEKIT_WORKER_ID=
# Declare only what is actually installed. Claiming unity on a machine without
# it means accepting game builds that cannot run.
RAZEKIT_WORKER_CAPABILITIES=node,npm,git
RAZEKIT_PRODUCTION_WORKER_HEARTBEAT_TIMEOUT_MS=120000

# ── Graph workers ────────────────────────────────────────────────────────────
# The process that claims and runs JEV nodes: `node src/jev-worker.js`.
# Run as many as you like; the claim is atomic, so two workers produce one
# winner and one "nothing to do".
# RAZEKIT_JEV_WORKER_ID=
RAZEKIT_JEV_WORKER_POLL_MS=1000
# How long a claimed node is held before it is considered stalled. The worker
# renews at a third of this while it works, so this is the window in which a
# worker that DIES is detected, not a limit on how long a node may take.
RAZEKIT_JEV_WORKER_LEASE_MS=120000
# Restrict a worker to one resource class (cpu, gpu, ...). Empty means any.
# RAZEKIT_JEV_WORKER_RESOURCE_CLASS=

# Whether the autonomous loop also RUNS nodes, or only decides what the graph
# should become. Leave true unless a worker is actually running: with no
# claimant, every graph would simply wait.
RAZEKIT_JEV_INLINE_EXECUTION=true

# ── Model nodes ──────────────────────────────────────────────────────────────
# Base cost of one model call, in whole currency units, before the per-kind
# weighting in jev-model-domain.js. At the default of zero nothing is reserved,
# so reserve-before-call holds no money — the measured cost is still recorded
# afterwards and the hard budget still binds, but the reservation only precedes
# the spend once this is set.
RAZEKIT_MODEL_NODE_COST=0
# How many repair cycles a task may go through before it stops for a person.
RAZEKIT_MAX_REPAIR_CYCLES=3
# Ceiling on the context compiled for one model node, in characters.
RAZEKIT_MODEL_CONTEXT_MAX_CHARS=24000
